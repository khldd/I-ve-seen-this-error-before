# Copy to .env and fill in. Never commit .env.
# Variables are read by src/steb/config.py (planned, Phase 1). Names may still change.

# --- Storage ---
STEB_HOME=./data                    # where the SQLite DB, indexes and caches live

# --- LLM provider ---
# One of: anthropic | openai | ollama   (API provider planned as default; exact choice TBD)
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings / reranking (sentence-transformers model ids; chosen in Phase 4) ---
EMBEDDING_MODEL=
RERANKER_MODEL=

# --- Agent ---
AGENT_MAX_CORRECTIVE_LOOPS=2

# --- External data (Phase 3) ---
GITHUB_TOKEN=                       # for the GitHub issues API (higher rate limits)
